{
  "name": "claude-bridge-vscode",
  "displayName": "Claude Bridge",
  "description": "Chat with a Claude shared through claude-remote-bridge: Claude explores your workspace and keeps working step by step until the task is done. Ask / auto-accept / auto / plan modes, per-file diffs with undo, question popups, model picker, and saved conversations.",
  "version": "3.6.0",
  "publisher": "claude-remote-bridge",
  "license": "UNLICENSED",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "AI",
    "Chat",
    "Other"
  ],
  "main": "./extension.js",
  "activationEvents": [],
  "scripts": {
    "vscode:prepublish": "node -e \"require('fs').copyFileSync('../bridge-core.js','bridge-core.js')\""
  },
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "claudeBridge",
          "title": "Claude Bridge",
          "icon": "media/icon.svg"
        }
      ]
    },
    "views": {
      "claudeBridge": [
        {
          "type": "webview",
          "id": "claudeBridge.chat",
          "name": "Chat"
        }
      ]
    },
    "commands": [
      {
        "command": "claudeBridge.focus",
        "title": "Claude Bridge: Focus Chat Input"
      },
      {
        "command": "claudeBridge.changeModel",
        "title": "Claude Bridge: Change Model",
        "icon": "$(chip)"
      },
      {
        "command": "claudeBridge.skills",
        "title": "Claude Bridge: Choose Skills",
        "icon": "$(sparkle)"
      },
      {
        "command": "claudeBridge.open",
        "title": "Claude Bridge: Open in New Tab",
        "icon": "media/icon.svg"
      },
      {
        "command": "claudeBridge.focusSidebar",
        "title": "Claude Bridge: Open in Sidebar"
      },
      {
        "command": "claudeBridge.newChat",
        "title": "Claude Bridge: New Conversation",
        "icon": "$(add)"
      },
      {
        "command": "claudeBridge.history",
        "title": "Claude Bridge: Past Conversations",
        "icon": "$(history)"
      },
      {
        "command": "claudeBridge.cycleMode",
        "title": "Claude Bridge: Switch Mode (ask / auto-accept / auto / plan)"
      },
      {
        "command": "claudeBridge.autoMode",
        "title": "Claude Bridge: Turn On Auto Mode (no approvals)"
      },
      {
        "command": "claudeBridge.undoLast",
        "title": "Claude Bridge: Undo Last Applied Changes"
      },
      {
        "command": "claudeBridge.connect",
        "title": "Claude Bridge: Settings (link, access code, allowed commands)",
        "icon": "$(gear)"
      },
      {
        "command": "claudeBridge.disconnect",
        "title": "Claude Bridge: Disconnect (forget link + access code)"
      },
      {
        "command": "claudeBridge.insertReference",
        "title": "Claude Bridge: Mention File in Chat"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "claudeBridge.open",
          "group": "navigation"
        }
      ],
      "explorer/context": [
        {
          "command": "claudeBridge.insertReference",
          "group": "7_modification"
        }
      ],
      "editor/context": [
        {
          "command": "claudeBridge.insertReference",
          "group": "9_cutcopypaste"
        }
      ]
    },
    "keybindings": [
      {
        "command": "claudeBridge.focus",
        "key": "ctrl+escape",
        "mac": "cmd+escape"
      },
      {
        "command": "claudeBridge.open",
        "key": "ctrl+alt+shift+b",
        "mac": "cmd+alt+shift+b"
      },
      {
        "command": "claudeBridge.insertReference",
        "key": "alt+k",
        "when": "editorTextFocus"
      },
      {
        "command": "claudeBridge.insertReference",
        "key": "ctrl+alt+shift+k",
        "mac": "cmd+alt+shift+k",
        "when": "editorTextFocus"
      },
      {
        "command": "claudeBridge.changeModel",
        "key": "ctrl+alt+shift+m",
        "mac": "cmd+alt+shift+m"
      }
    ],
    "configuration": {
      "title": "Claude Bridge",
      "properties": {
        "claudeBridge.autoMode.maxSteps": {
          "type": "number",
          "default": 30,
          "minimum": 1,
          "maximum": 500,
          "markdownDescription": "How many steps Claude may take for one message before it pauses (each step = one answer from Claude plus applying its edits and running its commands). Send `continue` to go on after a pause."
        },
        "claudeBridge.autoMode.commandTimeoutSeconds": {
          "type": "number",
          "default": 300,
          "minimum": 0,
          "markdownDescription": "In auto mode, a command that runs without your click is stopped after this many seconds (`0` = no limit), so a dev server or watcher cannot block the task."
        },
        "claudeBridge.autoMode.askBeforeRiskyCommands": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "In auto mode, still ask before commands that are hard to undo or reach outside the project: `sudo`, `git push`, `git reset --hard`, `rm -rf` outside the folder, publishing, global installs, `curl … | sh` and similar. Turn off to run everything without asking."
        }
      }
    }
  }
}
