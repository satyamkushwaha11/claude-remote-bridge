# Settings for server.js. Copy to .env (next to server.js). Real environment variables override this file.
# You can also skip this file: the server creates .env with a new ACCESS_CODE on first start.

# The secret your guest needs together with the link. It is never sent over the
# network; it is the encryption key. Leave empty to have one generated on first start,
# or create one with:  node server.js --gen-code
ACCESS_CODE=

# Where to listen. 127.0.0.1 = reachable only through a local tunnel
# (`node server.js --share`, or `tailscale serve`). Use your Tailscale IP
# (100.x.y.z) to listen on the tailnet directly. Avoid 0.0.0.0.
HOST=127.0.0.1
PORT=4000

# Max duration of one Claude run, in milliseconds. 0 = no limit.
TIMEOUT_MS=120000

# How many requests may wait behind the one that is running (extra ones get HTTP 429).
MAX_QUEUE=5

# Max request body size in bytes (encrypted prompt + attached files + history).
MAX_BODY_BYTES=8388608

# Optional: pin a model (e.g. sonnet, opus). Empty = the CLI default.
CLAUDE_MODEL=

# Models a guest may pick in VS Code or with /model (comma-separated CLI aliases or full names).
ALLOWED_MODELS=sonnet,opus,haiku,fable

# Optional: paths to the binaries if they are not on PATH.
# CLAUDE_BIN=/usr/local/bin/claude
# CLOUDFLARED_BIN=/usr/local/bin/cloudflared

# --- Public link (used with --share) ------------------------------------------
# quick       new random link on every start, no account needed (default)
# ngrok       the SAME link every time: free ngrok account + free static domain
# cloudflare  the SAME link every time on your own domain (named Cloudflare tunnel)
# none        start no tunnel, just announce PUBLIC_URL (e.g. Tailscale Funnel)
# Step-by-step setup: PM2.md, "A link that never changes".
TUNNEL=quick
# NGROK_DOMAIN=your-name.ngrok-free.app
# NGROK_AUTHTOKEN=
# CLOUDFLARE_TUNNEL_TOKEN=
# PUBLIC_URL=https://bridge.example.com
